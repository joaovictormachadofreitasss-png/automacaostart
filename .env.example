# Configurar essas variáveis em: Vercel → Project Settings → Environment Variables
# (e também em GitHub → Settings → Secrets, pros workflows em .github/workflows/ que
# rodam scripts/sync-meta.js e scripts/sync-vendas.js)
#
# NUNCA commitar um arquivo .env com valores reais. Este arquivo é só o modelo.

# ── Supabase ──
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role (NUNCA a publishable/anon) — usada pelos webhooks e scripts de sync
# pra gravar dados. A publishable/anon (só leitura) já está hardcoded nos dashboards
# porque é segura de expor (RLS bloqueia escrita).
SUPABASE_SECRET=

# ── Hotmart ──
# Basic auth (client_id:client_secret em base64) pra autenticar na API da Hotmart
HOTMART_BASIC=
# Token de validação do webhook (Ferramentas > Webhook no painel da Hotmart)
HOTMART_HOTTOK=

# ── Meta Ads ──
META_TOKEN=
META_ACT_ID=act_XXXXXXXXXXXX
META_CAMPAIGN_ID=

# ── Diagnóstico (formulário Apps Script) ──
DIAGNOSTICO_TOKEN=

# ── Telegram (notificação de venda) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Autenticação das dashboards internas (vendas.html, dashboard.html, diagnostico.html) ──
# Senha compartilhada com a equipe pra entrar em /login.html
DASHBOARD_PASSWORD=
# String aleatória longa, só pra assinar o cookie de sessão. Gerar uma vez com:
#   openssl rand -hex 32
# Trocar esse valor invalida todas as sessões ativas (força novo login pra todo mundo).
AUTH_SECRET=
